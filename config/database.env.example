# Salin nilai ini ke konfigurasi environment Apache/PHP, bukan ke source code.
# Contoh Apache: SetEnv SERVICENET_DB_HOST "db.example.internal"
SERVICENET_DB_HOST=
SERVICENET_DB_NAME=
SERVICENET_DB_USER=
SERVICENET_DB_PASSWORD=

# Notifikasi Telegram (isi hanya pada database.env di folder servicenet-private)
SERVICENET_TELEGRAM_TOKEN=
SERVICENET_TELEGRAM_CHAT_ID=
# Alamat aplikasi tanpa garis miring di akhir, untuk tautan detail Telegram.
SERVICENET_APP_URL=https://netcare.unisba.ac.id
